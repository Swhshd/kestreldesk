vars: { d2-config: { layout-engine: tala } }
direction: down
style.font-color: "#1E293B"
style.font-size: 15

customer: "Customer" {
  left: 130
  top: 10
  width: 130
  height: 65
  label.near: center-center
  style.font-size: 15
  style.fill: "#F1F5F9"
  style.stroke: "#64748B"
}
agent: "AI agent" {
  left: 130
  top: 90
  width: 130
  height: 65
  label.near: center-center
  style.font-size: 15
  style.fill: "#DBEAFE"
  style.stroke: "#2563EB"
}
request: "Handoff request" {
  left: 130
  top: 170
  width: 130
  height: 65
  label.near: center-center
  style.font-size: 15
  style.fill: "#DBEAFE"
  style.stroke: "#2563EB"
}
checks: "Business / team checks\nOptional confirmation" {
  left: 80
  top: 250
  width: 230
  height: 75
  label.near: center-center
  style.font-size: 15
  style.fill: "#EFF6FF"
  style.stroke: "#2563EB"
}
route: "Assignment?" {
  left: 125
  top: 345
  width: 140
  height: 90
  label.near: center-center
  shape: diamond
  style.font-size: 15
  style.fill: "#EDE9FE"
  style.stroke: "#7C3AED"
}
assigned: "Assigned employee" {
  left: 8
  top: 465
  width: 155
  height: 75
  label.near: center-center
  style.font-size: 15
  style.fill: "#F5F3FF"
  style.stroke: "#7C3AED"
}
queue: "Team queue" {
  left: 225
  top: 465
  width: 155
  height: 75
  label.near: center-center
  style.font-size: 15
  style.fill: "#F5F3FF"
  style.stroke: "#7C3AED"
}
workspace: "Employee workspace\nReply → customer" {
  left: 95
  top: 565
  width: 195
  height: 75
  label.near: center-center
  style.font-size: 15
  style.fill: "#DBEAFE"
  style.stroke: "#2563EB"
}
status: "Current end-to-end handoff\nremains partially validated." {
  left: 25
  top: 660
  width: 340
  shape: text
  style.font-size: 14
  style.font-color: "#64748B"
}

customer -> agent -> request -> checks -> route
route -> assigned: "Assigned"
route -> queue: "Queued"
assigned -> workspace
queue -> workspace
